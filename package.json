    "listen-whynottv": "node scripts/listen-whynottv-episodes.mjs",
    "fetch-zhang-junan": "node scripts/fetch-zhang-junan-posts.mjs",
    "check:live": "node scripts/site-check.mjs",
    "fetch-company-profiles": "node scripts/fetch-company-profiles.mjs"
