{
  "name": "stock-picks-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-podcast-latest.mjs && vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate-data.mjs",
    "paper": "node scripts/paper-held-quotes.mjs; node scripts/paper-trade.mjs",
    "fetch-us-options": "node scripts/fetch-us-options.mjs",
    "fetch-earnings": "node scripts/fetch-earnings.mjs",
    "strategies": "node scripts/run-strategies.mjs",
    "test:math": "node scripts/math-guards.mjs",
    "test:smoke": "npm run test:math && node scripts/predeploy-smoke.mjs",
    "predeploy": "npm run test:smoke && npm run build",
    "fetch-soxl": "node scripts/fetch-soxl.mjs",
    "fetch-txf": "node scripts/fetch-txf-desk.mjs",
    "fetch-us-macro": "node scripts/fetch-us-macro-calendar.mjs",
    "fetch-tw-macro": "node scripts/fetch-tw-macro-calendar.mjs",
    "fetch-gooaye": "node scripts/fetch-gooaye-episodes.mjs",
